# URL of the Argus marketplace (src/server.ts). The browser never talks to
# it directly: every call goes through the same-origin proxy at
# /api/q402/*, which forwards to this address server-side.
# Local dev:   MARKETPLACE_URL=http://localhost:4021
# Deployed:    point this at a publicly reachable marketplace (tunnel/host).
MARKETPLACE_URL=http://localhost:4021

# --- Coworker page (/coworker) ---------------------------------------------
# Server-side only, two modes:
#   Hosted: set SOKOSUMI_API_KEY (preprod.sokosumi.com/developer/api-keys) and
#     the route calls the Sokosumi Core API directly — no CLI needed.
#   Local: leave it unset and the route shells out to the `sokosumi` CLI,
#     which holds OAuth + the coworker runtime key on this machine.
COWORKER_ID=
SOKOSUMI_API_KEY=
# Org workspace targeting (unset = personal workspace):
SOKOSUMI_ORG_SLUG=
