# --- Cardano / x402 -------------------------------------------------------
# Free preprod project id from https://blockfrost.io
BLOCKFROST_PROJECT_ID=
BLOCKFROST_BASE_URL=https://cardano-preprod.blockfrost.io/api/v0
FACILITATOR_URL=http://localhost:4022
FACILITATOR_PORT=4022
CARDANO_NETWORK=cardano:preprod

# Seller wallet: signs Masumi terms and receives payments. Generate via
# `npm run wallet` — needs no funding to sign; fund it to collect.
SELLER_MNEMONIC=

# Buyer (agent) wallet: pays per query. Fund via preprod faucet.
BUYER_MNEMONIC=

# Escrow mode: "masumi" locks funds in the Masumi smart contract (auto-refund
# on failed delivery). "default" is a plain address payment.
ESCROW=masumi

# --- NOWNodes -------------------------------------------------------------
# API key from https://nownodes.io — powers all dataset queries.
# Leave empty to run the server in demo-fixture mode (offline development).
NOWNODES_API_KEY=

# --- CoinGecko --------------------------------------------------------------
# Demo-tier key from https://www.coingecko.com/en/api — powers the market-data
# SKUs (market-snapshot, trending) and decision enrichment. Optional: without
# it those SKUs serve fixture data and decisions lose market context.
COINGECKO_API_KEY=

# --- Server ---------------------------------------------------------------
PORT=4021
# Dev-only: mount unpaid /dev/<sku> mirrors of every product (localhost only).
DEV_BYPASS=1

# --- Sokosumi coworker ----------------------------------------------------
# Created by `bash scripts/sokosumi-setup.sh` after `sokosumi --preprod auth login`.
COWORKER_ID=
# Vendor id from `sokosumi --preprod vendors me --json` (needed by the setup
# script's connect step).
VENDOR_ID=
# Organization Workspace only (leave unset for personal Workspace):
COWORKER_ORG_SLUG=
COWORKER_ORG_ID=
# Poll interval for READY tasks (ms).
COWORKER_POLL_MS=15000
# Paid mode: the worker buys each answer over x402 from the marketplace
# (needs BUYER_MNEMONIC + BLOCKFROST_PROJECT_ID). Results carry the real
# settlement tx; the web console renders it as the receipt.
COWORKER_PAID=0
COWORKER_SELLER_URL=https://query402-marketplace.onrender.com
